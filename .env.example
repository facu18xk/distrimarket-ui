# Copiar a .env.local y ajustar si hace falta. Ninguna de estas variables es secreta.

# Desarrollo: API Gateway al que Vite reenvía /ventas, /inventario y /compras.
DEV_GATEWAY_TARGET=http://localhost:8080

# Producción: URL pública del API Gateway. Vacío = mismo origen que la UI
# (lo normal en desarrollo, donde el proxy de Vite hace el reenvío).
VITE_API_GATEWAY_URL=
